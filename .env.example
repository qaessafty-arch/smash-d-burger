# Copy to .env.local (or set in your host's dashboard). None of these are exposed to the browser.

# Where the SQLite database lives. Put it on a persistent disk/volume.
DATABASE_PATH=./data/restaurant.db

# Where uploaded menu photos are stored (persistent disk too).
UPLOAD_DIR=./data/uploads

# First start only: the administrator account to create.
# If ADMIN_PASSWORD is empty a random one is generated and printed once in the server log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Session cookies are Secure (HTTPS only) in production. Set to 1 ONLY if you serve over plain HTTP on a private network.
INSECURE_COOKIES=0
